{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/assets/(fonts|img|icons)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(wp-content|wp-includes|cdn-cgi)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/cadastro/index.html", "destination": "/cadastro/", "statusCode": 301 },
    { "source": "/login/index.html", "destination": "/login/", "statusCode": 301 },
    { "source": "/corujao/index.html", "destination": "/corujao/", "statusCode": 301 },
    { "source": "/corujao/3a-edicao/index.html", "destination": "/corujao/3a-edicao/", "statusCode": 301 },
    { "source": "/corujao/alavancagem-zero-risco/index.html", "destination": "/corujao/alavancagem-zero-risco/", "statusCode": 301 },
    { "source": "/corujao/ranking/index.html", "destination": "/corujao/ranking/", "statusCode": 301 },
    { "source": "/corretoras-digitais-plataformas-online-diferencas/index.html", "destination": "/corretoras-digitais-plataformas-online-diferencas/", "statusCode": 301 },
    { "source": "/author/", "destination": "/", "statusCode": 301 },
    { "source": "/author/:slug/", "destination": "/", "statusCode": 301 },
    { "source": "/author/:slug/:resto+/", "destination": "/", "statusCode": 301 },
    { "source": "/author", "destination": "/", "statusCode": 301 },
    { "source": "/author/:slug", "destination": "/", "statusCode": 301 },
    { "source": "/page-sitemap.xml", "destination": "/sitemap.xml", "statusCode": 301 },
    { "source": "/post-sitemap.xml", "destination": "/sitemap.xml", "statusCode": 301 },
    { "source": "/category-sitemap.xml", "destination": "/sitemap.xml", "statusCode": 301 },
    { "source": "/embed", "destination": "/", "permanent": true },
    { "source": "/bemvindo", "destination": "/cadastro/?aff=835403&afftrack=bemvindo", "statusCode": 302 },
    { "source": "/bemvindo/", "destination": "/cadastro/?aff=835403&afftrack=bemvindo", "statusCode": 302 }
  ]
}
